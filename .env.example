# Contact form email configuration
# Copy these into .env.local (local) and into Vercel > Project > Settings > Environment Variables (production).

# Where contact form submissions are delivered
CONTACT_TO_EMAIL=info@macrosolution.mu

# SMTP account used to SEND the email (recommended).
# If SMTP_HOST / SMTP_USER / SMTP_PASS are not set, the form falls back to FormSubmit.co,
# which only delivers after the one-time activation link sent to CONTACT_TO_EMAIL is clicked.
#
# Examples:
#   Own domain mailbox (cPanel/hosting): SMTP_HOST=mail.macrosolution.mu  SMTP_PORT=465
#   Microsoft 365:                       SMTP_HOST=smtp.office365.com     SMTP_PORT=587
#   Gmail (needs an App Password):       SMTP_HOST=smtp.gmail.com         SMTP_PORT=465
SMTP_HOST=mail.macrosolution.mu
SMTP_PORT=465
SMTP_USER=info@macrosolution.mu
SMTP_PASS=your-mailbox-password

# Optional: the From address (defaults to SMTP_USER). Must be allowed by your SMTP provider.
# SMTP_FROM=info@macrosolution.mu
